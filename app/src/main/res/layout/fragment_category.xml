<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 头部布局 - 固定在顶部 -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 筛选条件行 - 拼多多风格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:background="@android:color/white">

            <!-- 综合/排序 -->
            <FrameLayout
                android:id="@+id/filter_sort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_sort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="综合"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_filter_item" />
            </FrameLayout>

            <!-- 工艺 -->
            <FrameLayout
                android:id="@+id/filter_method"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="工艺"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_filter_item" />
            </FrameLayout>

            <!-- 口味 -->
            <FrameLayout
                android:id="@+id/filter_taste"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_taste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="口味"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_filter_item" />
            </FrameLayout>

            <!-- 难度 -->
            <FrameLayout
                android:id="@+id/filter_difficulty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_difficulty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="难度"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_filter_item" />
            </FrameLayout>

            <!-- 筛选图标 -->
            <FrameLayout
                android:id="@+id/filter_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/iv_filter"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_filter"
                    android:background="@drawable/bg_filter_icon" />
            </FrameLayout>
        </LinearLayout>

        <!-- 已选条件标签 -->
        <HorizontalScrollView
            android:id="@+id/hsv_selected_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ll_selected_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 下拉框容器 - 放在头部下方 -->
    <FrameLayout
        android:id="@+id/dropdown_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/actionBarSize"
        android:visibility="gone"
        android:elevation="8dp">

        <!-- 排序下拉框 -->
        <LinearLayout
            android:id="@+id/dropdown_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:visibility="gone">

            <TextView
                android:id="@+id/dropdown_sort_all"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="综合"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_sort_ingredient"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="食材匹配"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_sort_tag"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="标签匹配"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />
        </LinearLayout>

        <!-- 工艺下拉框 -->
        <LinearLayout
            android:id="@+id/dropdown_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:visibility="gone">

            <TextView
                android:id="@+id/dropdown_method_all"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="全部"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_method_fry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="煎"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_method_stir"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="炒"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_method_boil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="煮"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_method_deepfry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="炸"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_method_stew"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="炖"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_method_pickle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="腌"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_method_roast"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="烧"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_method_mix"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="拌"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_method_other"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="其他"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />
        </LinearLayout>

        <!-- 口味下拉框 (多选) -->
        <LinearLayout
            android:id="@+id/dropdown_taste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:visibility="gone">

            <TextView
                android:id="@+id/dropdown_taste_all"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="全部"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_taste_sour"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="酸"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_taste_sweet"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="甜"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_taste_bitter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="苦"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_taste_spicy"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="辣"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_taste_salty"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="咸"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_taste_umami"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="鲜"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="8dp" android:background="#f5f5f5" />

            <!-- 多选确认按钮 -->
            <TextView
                android:id="@+id/dropdown_taste_confirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="确定"
                android:textSize="16sp"
                android:textColor="#FF6B4A"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_dropdown_confirm" />
        </LinearLayout>

        <!-- 难度下拉框 -->
        <LinearLayout
            android:id="@+id/dropdown_difficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:visibility="gone">

            <TextView
                android:id="@+id/dropdown_diff_all"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="全部"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_diff_easy"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="简单"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_diff_normal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="普通"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_diff_hard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="高级"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <TextView
                android:id="@+id/dropdown_diff_god"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="神级"
                android:textSize="14sp"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_dropdown_item" />
        </LinearLayout>
    </FrameLayout>

    <!-- 遮罩层 - 用于点击关闭下拉框 -->
    <View
        android:id="@+id/v_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- 使用 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recipes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:padding="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- 加载进度条 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 空状态视图 -->
    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="加载中..."
        android:textSize="18sp"
        android:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>