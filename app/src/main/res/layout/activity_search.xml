<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 搜索栏 -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_splash_gradient"
            android:elevation="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 返回图标 -->
                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="返回"
                    android:padding="4dp"
                    android:src="@drawable/back" />

                <!-- 搜索框容器：包含输入框和搜索图标，占据剩余宽度 -->
                <LinearLayout
                    android:id="@+id/search_container"
                    android:layout_width="343dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="-8dp"
                    android:layout_marginEnd="12dp"
                    android:layout_toEndOf="@+id/iv_back"
                    android:background="@drawable/bg_search_rounded_white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="输入食谱或食材名称"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingVertical="8dp"
                        android:textColor="#000000"
                        android:textColorHint="#999999" />

                    <!-- 搜索图标，位于输入框右侧 -->
                    <ImageView
                        android:id="@+id/iv_search_action"
                        android:layout_width="47dp"
                        android:layout_height="match_parent"
                        android:contentDescription="搜索"
                        android:padding="8dp"
                        android:src="@drawable/search" />
                </LinearLayout>

            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- 分类标签 -->
        <HorizontalScrollView
            android:id="@+id/horizontal_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/actionBarSize"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_all"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/bg_tab_selected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="全部"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_tag_match"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/bg_tab_normal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="标签匹配值"
                    android:textColor="#666666"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_ingredient_match"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginRight="12dp"
                    android:background="@drawable/bg_tab_normal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="原料匹配度"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 菜谱列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recipes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="100dp"
            android:padding="8dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="1"
            tools:listitem="@layout/item_recipe" />

        <!-- 加载进度条 -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 空状态视图 -->
    </FrameLayout>
</androidx.core.widget.NestedScrollView>